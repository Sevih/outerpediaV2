[
  {
    "_comment": "Description-based pattern discovery. Each entry is a regex applied against the English skill description; on match, the listed labels are added as buffs/debuffs. Runs last, after the BuffTemplet-driven classification.",
    "pattern": "",
    "flags": ""
  },
  {
    "_comment": "=== CP (Chain Points) — buff variants ===",
    "pattern": "(grants?|restores?|recovers?|increases?)\\s+[^.\\n]{0,40}?(Chain Points|\\bCP\\b)",
    "flags": "i",
    "add_buff": ["BT_CP_CHARGE"]
  },
  {
    "pattern": "(<[^>]+>)?\\s*(Chain Points|\\bCP\\b)(<[^>]+>)?\\s+(is|are)\\s+(restored|recovered|increased|granted)",
    "flags": "i",
    "add_buff": ["BT_CP_CHARGE"]
  },
  {
    "_comment": "=== CP (Chain Points) — debuff variants ===",
    "pattern": "reduces?\\s+(all\\s+|the\\s+enemy\\s+team's\\s+)?(<[^>]+>)?\\s*(Chain Points|\\bCP\\b)(<[^>]+>)?(\\s+of\\s+enem|\\s+by\\s+)",
    "flags": "i",
    "add_debuff": ["BT_CP_CHARGE"]
  },
  {
    "pattern": "(enemy|enemies|target)('s|s')?\\s*(<[^>]+>)?\\s*(Chain Points|\\bCP\\b)(<[^>]+>)?\\s+(is|are)\\s+reduced",
    "flags": "i",
    "add_debuff": ["BT_CP_CHARGE"]
  },
  {
    "_comment": "=== AP (Action Points) — buff variants ===",
    "pattern": "(grants?|restores?|recovers?|increases?)\\s+[^.\\n]{0,40}?(Action Points|\\bAP\\b)",
    "flags": "i",
    "add_buff": ["BT_AP_CHARGE"]
  },
  {
    "pattern": "(<[^>]+>)?\\s*(Action Points|\\bAP\\b)(<[^>]+>)?\\s+(is|are)\\s+(restored|recovered|increased|granted)",
    "flags": "i",
    "add_buff": ["BT_AP_CHARGE"]
  },
  {
    "_comment": "=== AP (Action Points) — debuff variants ===",
    "pattern": "reduces?\\s+(all\\s+|the\\s+enemy\\s+team's\\s+)?(<[^>]+>)?\\s*(Action Points|\\bAP\\b)(<[^>]+>)?(\\s+of\\s+enem|\\s+by\\s+)",
    "flags": "i",
    "add_debuff": ["BT_AP_CHARGE"]
  },
  {
    "pattern": "(enemy|enemies|target)('s|s')?\\s*(<[^>]+>)?\\s*(Action Points|\\bAP\\b)(<[^>]+>)?\\s+(is|are)\\s+reduced",
    "flags": "i",
    "add_debuff": ["BT_AP_CHARGE"]
  },
  {
    "pattern": "(Grants?|gains?) Courage Against Despair",
    "flags": "i",
    "add_buff": ["COURAGE_AGAINST_DESPAIR"]
  },
  {
    "_comment": "Matches both 'does not trigger ... Counterattack/Revenge/Agile Response' and 'Counterattack, Revenge, and Agile Response cannot activate' phrasings.",
    "pattern": "(does not trigger|avoid triggering|cannot activate|will not activate|Unable to|\\bcannot\\b).*?Counterattack|Counterattack.*?(does not trigger|cannot activate|will not activate)",
    "flags": "is",
    "add_buff": ["BT_SEAL_COUNTER"]
  },
  {
    "pattern": "grants 【Environmental Change Response】 or 【Weather Variable Response】 ",
    "flags": "i",
    "add_buff": ["UNIQUE_VENION_A", "UNIQUE_VENION_B"]
  },
  {
    "pattern": "grants 【Remove Detection Interference】 or 【Exclude Unknown Variables】",
    "flags": "i",
    "add_buff": ["UNIQUE_VENION_D", "UNIQUE_VENION_E"]
  },
  {
    "pattern": "Heavy Strike",
    "flags": "",
    "add_buff": ["HEAVY_STRIKE"]
  },
  {
    "pattern": "gains an (<[^>]+>)?(extra turn)",
    "flags": "i",
    "add_buff": ["BT_ADDITIVE_TURN"]
  },
  {
    "pattern": "reduces? (the )?(<[^>]+>)?WG(<[^>]+>)? by",
    "flags": "i",
    "add_debuff": ["BT_WG_REVERSE_HEAL"]
  },{
    "pattern": "Inflicts <color=#28d9ed>Frozen</color>",
    "flags": "i",
    "add_debuff": ["BT_FREEZE"]  
  },{
    "pattern": "cannot be Resurrected or Revived.",
    "flags": "i",
    "add_debuff": ["BT_SEALED_RESURRECTION"]  
  },{
    "pattern": "inflicts?\\s+(<[^>]+>)?instant death",
    "flags": "i",
    "add_debuff": ["BT_KILL_UNDER_HP_RATE"]  
  },{
    "pattern": "Grants a <color=#28d9ed>special effect</color> to the enemy team based on their element",
    "flags": "i",
    "add_buff": ["COURAGE_DESPAIR_ELEM"]  ,
    "remove_buff": ["COURAGE_AGAINST_DESPAIR"] 
  }
]
